:root {
  --paper: #f1ead8;
  --paper-2: #e9dfc8;
  --ink: #171512;
  --muted: #6c6558;
  --rule: #26221d;
  --accent: #7e211b;
  --stage: #222326;
}

* { box-sizing: border-box; }
html { color-scheme: light; }
body {
  margin: 0;
  min-width: 320px;
  color: #f4efe6;
  background:
    radial-gradient(circle at 50% -10%, #545456 0, #323337 42%, #1f2023 100%);
  font-family: "Libre Franklin", Arial, sans-serif;
}
button { font: inherit; }

.site-shell { width: min(1440px, 100%); margin: 0 auto; padding: 20px 14px 32px; }
.viewer-header {
  width: min(1160px, 100%);
  margin: 0 auto 10px;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 24px;
}
.viewer-brand h1 { margin: 0; font: 900 clamp(1.9rem, 4vw, 3.3rem)/.95 "Playfair Display", Georgia, serif; letter-spacing: -.045em; }
.eyebrow { margin: 0 0 4px; font-size: .66rem; letter-spacing: .16em; text-transform: uppercase; opacity: .68; }
.viewer-help { max-width: 430px; margin: 0 0 3px; color: #d5d0c8; font-size: .83rem; text-align: right; }

.book-stage { display: flex; justify-content: center; align-items: center; min-height: 620px; padding: 12px 0 18px; overflow: hidden; }
.book { margin: auto; }
.page { position: relative; overflow: hidden; color: var(--ink); background: var(--paper); border: 1px solid rgba(0,0,0,.1); }
.page::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: .22;
  background-image:
    repeating-linear-gradient(0deg, rgba(92,70,35,.025) 0, rgba(92,70,35,.025) 1px, transparent 1px, transparent 4px),
    radial-gradient(circle at 18% 12%, rgba(138,108,57,.11), transparent 29%),
    radial-gradient(circle at 82% 85%, rgba(120,83,37,.08), transparent 34%);
  mix-blend-mode: multiply;
}
.page-inner { position: relative; z-index: 1; display: flex; flex-direction: column; height: 100%; padding: 24px 27px 20px; }

.masthead { border-top: 5px solid var(--ink); border-bottom: 3px solid var(--ink); padding: 6px 0 8px; text-align: center; }
.masthead > p { margin: 0 0 1px; font-size: .49rem; font-weight: 800; letter-spacing: .14em; }
.masthead h2 { margin: 0; font: 900 2.55rem/.93 "Playfair Display", Georgia, serif; letter-spacing: -.055em; }
.masthead-rule { margin-top: 7px; padding-top: 5px; border-top: 1px solid var(--ink); display: flex; justify-content: space-between; font-size: .48rem; font-weight: 800; letter-spacing: .1em; }

.cover-lead { padding-top: 10px; flex: 1; }
.section-tag, .kicker, .note-label { color: var(--accent); font-size: .51rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
.section-tag, .kicker { margin: 0 0 5px; }
.cover-lead h3 { margin: 0; font: 900 2.35rem/.91 "Playfair Display", Georgia, serif; letter-spacing: -.05em; }
.cover-lead h4 { margin: 5px 0 7px; font: 800 1rem/1.05 "Playfair Display", Georgia, serif; }
.deck { margin: 0 0 8px; font: 600 .64rem/1.33 "Libre Franklin", sans-serif; }
.hero-figure, .feature-photo { margin: 0; }
.hero-figure img { width: 100%; height: 154px; object-fit: cover; object-position: center 34%; border: 1px solid #3e3931; filter: saturate(.78) contrast(1.02); }
figcaption { margin-top: 3px; color: #5f584d; font: 400 .42rem/1.25 "Libre Franklin", sans-serif; }
.cover-story { margin-top: 7px; }

.running-head { display: flex; justify-content: space-between; gap: 10px; border-bottom: 1px solid var(--ink); padding-bottom: 4px; margin-bottom: 11px; font-size: .45rem; font-weight: 800; letter-spacing: .12em; }
.article-title { margin: 0 0 7px; font: 900 1.85rem/.95 "Playfair Display", Georgia, serif; letter-spacing: -.04em; }
.section-title { margin: 0 0 9px; font: 900 1.45rem/.98 "Playfair Display", Georgia, serif; letter-spacing: -.035em; }
.story-columns { text-align: justify; font: 400 .585rem/1.42 Georgia, "Times New Roman", serif; }
.story-columns p { margin: 0 0 7px; break-inside: avoid; }
.two-cols { column-count: 2; column-gap: 18px; }
.tight { font-size: .56rem; line-height: 1.39; }
.compact-story { font-size: .535rem; line-height: 1.36; }
.dropcap-first::first-letter { float: left; margin: 2px 4px 0 0; font: 900 2.15rem/.72 "Playfair Display", Georgia, serif; }
blockquote { margin: 5px 0 8px; padding: 6px 8px; border-left: 4px solid var(--accent); font: 700 .62rem/1.33 "Playfair Display", Georgia, serif; break-inside: avoid; }
.pullquote { margin: 8px 0 0; padding: 6px 8px; border-top: 3px double var(--ink); border-bottom: 1px solid var(--ink); text-align: center; font: 800 .78rem/1.18 "Playfair Display", Georgia, serif; }
.pullquote.small { font-size: .68rem; }

.side-note { margin-top: auto; padding-top: 8px; border-top: 3px solid var(--ink); display: grid; grid-template-columns: 150px minmax(0,1fr); gap: 10px; align-items: start; }
.side-note img { width: 150px; height: 74px; object-fit: cover; border: 1px solid #767064; }
.side-note h3, .sports-note h3, .ad-copy h3 { margin: 3px 0 3px; font: 800 .78rem/1.02 "Playfair Display", Georgia, serif; }
.side-note p, .sports-note p, .ad-copy p { margin: 0; font: 400 .49rem/1.32 "Libre Franklin", sans-serif; }

.mid-photo { margin-top: 7px; }
.mid-photo img { width: 100%; height: 150px; object-fit: cover; object-position: center 52%; filter: saturate(.72); }
.defenders-photo { margin-top: auto; }
.defenders-photo img { width: 100%; height: 180px; object-fit: cover; object-position: center 43%; filter: saturate(.78); }
.judges-photo { margin-top: 8px; }
.judges-photo img { width: 100%; height: 188px; object-fit: cover; object-position: center 43%; filter: saturate(.76); }

.ad-morat { margin-top: auto; padding-top: 7px; border-top: 4px double var(--ink); display: grid; grid-template-columns: 174px 1fr; grid-template-rows: auto 1fr; gap: 5px 10px; }
.ad-head { grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
.ad-head span { font-size: .42rem; letter-spacing: .15em; }
.ad-head strong { font: 800 .64rem/1 "Libre Franklin", sans-serif; letter-spacing: .05em; }
.ad-morat img { width: 174px; height: 64px; object-fit: cover; border: 1px solid #4d4840; }
.ad-copy h3 { margin-top: 0; }

.sports-note { margin-top: auto; padding-top: 8px; border-top: 4px double var(--ink); display: grid; grid-template-columns: 100px minmax(0,1fr); gap: 11px; align-items: center; }
.sports-note img { width: 100px; height: 168px; object-fit: cover; border: 1px solid #5b554d; }
.sports-note h3 { font-size: .95rem; }
.sports-note p { font-size: .52rem; }

.verdict-page { padding-bottom: 18px; }
.verdict-title { margin-bottom: 5px; }
.verdict-copy { font-size: .565rem; }
.verdict-box { margin-top: 7px; border: 3px solid var(--ink); padding: 7px 9px; background: rgba(255,255,255,.14); }
.verdict-box > span { display: block; margin-bottom: 5px; color: var(--accent); font-size: .46rem; font-weight: 800; letter-spacing: .17em; text-align: center; }
.verdict-box div { display: flex; justify-content: space-between; gap: 12px; padding: 4px 0; border-top: 1px solid #665f54; font-size: .55rem; }
.verdict-box div:first-of-type { border-top: 2px solid var(--ink); }
.verdict-box strong { font-weight: 800; }
.verdict-box b { font-family: "Playfair Display", Georgia, serif; }
.closing-question { margin: 6px 0 0; text-align: center; font: 900 1rem/1 "Playfair Display", Georgia, serif; }

.folio { margin-top: auto; padding-top: 6px; border-top: 1px solid #777064; display: flex; justify-content: space-between; gap: 10px; color: #514b42; font-size: .41rem; font-weight: 800; letter-spacing: .04em; }

.back-cover-inner { margin: 9px; height: calc(100% - 18px); border: 9px double var(--ink); justify-content: center; align-items: center; text-align: center; padding: 28px; }
.back-kicker { margin: 0 0 14px; color: var(--accent); font-size: .56rem; font-weight: 800; letter-spacing: .18em; }
.back-cover h2 { margin: 0; font: 900 3rem/.83 "Playfair Display", Georgia, serif; letter-spacing: -.07em; }
.back-rule { width: 140px; margin: 20px 0 12px; border-top: 5px solid var(--ink); border-bottom: 1px solid var(--ink); height: 9px; }
.back-date { margin: 0; font-size: .62rem; font-weight: 800; letter-spacing: .16em; }
.back-copy { max-width: 310px; margin: 18px auto 0; font: 600 .7rem/1.38 "Libre Franklin", sans-serif; }
.back-seal { margin-top: 28px; width: 76px; height: 76px; display: grid; place-items: center; border: 3px double var(--ink); border-radius: 50%; font: 900 1.35rem "Playfair Display", Georgia, serif; }
.back-instruction { margin: 18px 0 0; color: var(--muted); font-size: .48rem; }
.back-cover .folio { position: absolute; left: 28px; right: 28px; bottom: 19px; }

.controls { display: flex; justify-content: center; align-items: center; gap: 12px; margin-top: 4px; }
.controls button { min-height: 44px; padding: 9px 17px; border: 1px solid rgba(255,255,255,.22); border-radius: 999px; color: #fff; background: #38393d; box-shadow: 0 6px 18px rgba(0,0,0,.18); cursor: pointer; }
.controls button:hover:not(:disabled) { background: #4b4c51; }
.controls button:disabled { opacity: .38; cursor: default; }
.controls button:focus-visible { outline: 3px solid white; outline-offset: 2px; }
.page-status { min-width: 70px; text-align: center; color: #ddd8ce; font-size: .76rem; }
.gesture-tip { margin: 8px 0 0; text-align: center; color: #aaa59d; font-size: .68rem; }
.load-error { margin: 9px 0 0; text-align: center; color: #ffe8aa; font-size: .78rem; }

@media (max-width: 740px) {
  .site-shell { padding: 13px 6px 24px; }
  .viewer-header { align-items: flex-start; padding: 0 7px; }
  .viewer-help { display: none; }
  .viewer-brand h1 { font-size: 2rem; }
  .book-stage { min-height: 500px; padding: 6px 0 10px; }
  .controls { position: relative; z-index: 30; }
  .controls button { padding-inline: 13px; font-size: .8rem; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; scroll-behavior: auto !important; }
}
